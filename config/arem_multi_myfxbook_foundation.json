    "master_policy": "produces ENTRY/NO_ENTRY, BUY/SELL and EXIT decisions",
    "risk_supervisor": "deterministic hard limits outside the AI policy"
  },
  "anti_cancellation_rule": "Do not train one undifferentiated average policy across opposing strategies. Preserve strategy_id, edge_family and regime labels and use routing/mixture-of-experts.",
  "training_stages": [
    "INGEST_EACH_STRATEGY",
    "BUILD_STRATEGY_CLONE",
    "EXTRACT_EDGE_EMBEDDINGS",
    "CLUSTER_BY_EDGE_FAMILY",
    "INJECT_MATH_EDGE_FEATURES_AND_CONSTRAINTS",
