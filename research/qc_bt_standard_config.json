  },
  "relation_to_nautilus": {
    "canonical_nautilus": "docs/MULTI_CHAT_NAUTILUS_BT_PROTOCOL_v1.md",
    "qc_role": "Second engine / data-source comparison, not a Nautilus substitute"
  }
